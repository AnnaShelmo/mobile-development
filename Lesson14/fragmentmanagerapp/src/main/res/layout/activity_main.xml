<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Список стран подключён СТАТИЧЕСКИ: тег fragment + android:name (полное имя класса).
         Такой фрагмент создаёт сам FragmentManager при раздувании макета. -->
    <fragment
        android:id="@+id/countryListFragment"
        android:name="com.mirea.shelmichas.fragmentmanagerapp.CountryListFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Пустой контейнер под детали. Фрагмент сюда добавляется ДИНАМИЧЕСКИ
         транзакцией replace() в MainActivity. android:name здесь не указывается. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/detailsContainerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

</androidx.appcompat.widget.LinearLayoutCompat>
