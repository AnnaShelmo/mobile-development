<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Приложение всегда светлое, поэтому ночная тема повторяет светлую. -->
    <style name="Base.Theme.NavigationDrawerApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/day_primary</item>
        <item name="colorOnPrimary">@color/day_on_primary</item>
        <item name="colorPrimaryContainer">@color/day_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/day_on_primary_container</item>
        <item name="colorSecondary">@color/day_secondary</item>
        <item name="colorOnSecondary">@color/day_on_secondary</item>
        <item name="colorSecondaryContainer">@color/day_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/day_on_secondary_container</item>
        <item name="colorSurface">@color/day_surface</item>
        <item name="colorOnSurface">@color/day_on_background</item>
        <item name="colorSurfaceVariant">@color/day_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/day_on_surface_variant</item>
        <item name="colorOutline">@color/day_outline</item>
        <item name="android:colorBackground">@color/day_background</item>
        <item name="android:windowBackground">@color/day_background</item>
        <item name="android:statusBarColor">@color/day_background</item>
        <item name="android:navigationBarColor">@color/day_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
