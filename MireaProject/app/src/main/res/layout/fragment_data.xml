<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Культурный дневник"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ваш персональный путеводитель по культурной жизни Москвы.\n\nЗдесь вы найдёте афишу мероприятий, карту знаковых мест, аудиогид, фотографии и заметки о впечатлениях. Открывайте для себя столицу вместе с Культурным дневником!"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>