<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Профиль"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewProfileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Статус: гость"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textViewProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Данные клиента (SharedPreferences)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/fieldClientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Имя клиента"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/fieldClientPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Телефон"
            android:inputType="phone" />

        <Button
            android:id="@+id/buttonSaveClient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить данные клиента" />

        <Button
            android:id="@+id/buttonProfileAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Войти" />

    </LinearLayout>

</ScrollView>
