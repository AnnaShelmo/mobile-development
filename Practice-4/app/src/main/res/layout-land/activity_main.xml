<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <ImageView
        android:id="@+id/imageAlbum"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="16dp"/>

    <TextView
        android:id="@+id/textSongTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Название песни"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imageAlbum"
        app:layout_constraintTop_toTopOf="@id/imageAlbum"
        android:layout_marginStart="16dp"/>

    <TextView
        android:id="@+id/textArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Исполнитель"
        app:layout_constraintStart_toStartOf="@id/textSongTitle"
        app:layout_constraintTop_toBottomOf="@id/textSongTitle"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/buttonPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Play"
        app:layout_constraintStart_toStartOf="@id/textSongTitle"
        app:layout_constraintTop_toBottomOf="@id/textArtist"
        android:layout_marginTop="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>